# roBrowserLegacy Remote Client — configuration
#
# Every variable below is read from the environment; this file is loaded at
# startup if it sits next to the binary's working directory.  Names and
# defaults match roBrowserLegacy-RemoteClient-JS, so an existing .env works
# unchanged.

PORT=3338

# Required.  The server refuses to start without it, exactly as the JS
# implementation does.  It is the origin the client is served from, and it is
# added to the CORS allowlist.
CLIENT_PUBLIC_URL=http://127.0.0.1:3338

# "production" quiets the startup report unless something failed.
NODE_ENV=development

# --- Cache -------------------------------------------------------------------
# LRU over both limits.  A single entry larger than 10% of the memory budget is
# never cached, so one map file cannot evict the whole interface.
CACHE_MAX_FILES=5000
CACHE_MAX_MEMORY_MB=1024

# Preload the assets every session needs before anything asks for them.
CACHE_WARM_UP=false
CACHE_WARM_UP_LIMIT=500

# --- Unified server ----------------------------------------------------------
# Serve the built roBrowserLegacy bundle at / as well as the game assets.
ENABLE_STATIC_SERVE=true
ROBROWSER_PATH=../roBrowserLegacy/dist/Web

# Proxy WebSocket connections through to rAthena's TCP ports.
ENABLE_WSPROXY=true

# The allowlist is a security boundary: without it this process is an open TCP
# relay to anything it can route to.  Defaults to the loopback trio
# (127.0.0.1:6900, :6121, :5121) when unset.
#WS_ALLOWED_TARGETS=127.0.0.1:6900,127.0.0.1:6121,127.0.0.1:5121

# Docker Desktop on macOS/Windows:
#WS_ALLOWED_TARGETS=host.docker.internal:6900,host.docker.internal:6121,host.docker.internal:5121

# --- Assets ------------------------------------------------------------------
# A directory of loose data files that beat the archives — this is how a
# translation is applied without repacking a 2.4 GB GRF.  A leading "data/" is
# stripped from the request before the lookup, so point this at a client's
# data/ folder.
#DATA_OVERRIDE_PATH=../cliente_exe/data

# Where DATA.INI and the archives it names live.
#CLIENT_RESPATH=resources/
#CLIENT_DATAINI=DATA.INI

# Serve POST /search and POST /.
#CLIENT_ENABLESEARCH=true

# Write every served asset out to disk beside the server.  The JS
# implementation does this unconditionally; here it is off by default, because
# it silently doubles a client's disk footprint and makes the server keep
# serving stale bytes after an archive is replaced.
#CLIENT_AUTOEXTRACT=false

# Override GRF filename decoding instead of detecting it: cp949 or utf-8.
#GRF_FILENAME_ENCODING=cp949

# --- Server ------------------------------------------------------------------
# Resolve resources/, data/, logs/ and index.html against this instead of the
# working directory.  Useful when the binary is launched from inside an app
# bundle.
#SERVER_ROOT=/path/to/client/root

# Interface to bind.  127.0.0.1 keeps the server off the network entirely,
# which is what an embedded offline app wants.
#HOST=0.0.0.0

# Gzip text and compressible game assets on the wire.
#ENABLE_COMPRESSION=true
